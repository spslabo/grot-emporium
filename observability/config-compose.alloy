// Generated by scripts/sync_grot_alloy.py; edit observability/components instead.
// Destinations are runtime configuration. Never substitute their values into this file.
logging { level = "info" }
otelcol.receiver.otlp "grot" {
  http { endpoint = "0.0.0.0:4318" }
  grpc { endpoint = "0.0.0.0:4317" }
  output {
    traces = [otelcol.processor.batch.grot.input]
    metrics = [otelcol.processor.filter.agent_metrics.input]
  }
}
otelcol.processor.filter "agent_metrics" {
  error_mode = "ignore"
  metrics { metric = ["not IsMatch(name, \"^gen_ai[.]\")"] }
  output { metrics = [otelcol.processor.batch.grot.input] }
}
otelcol.processor.batch "grot" {
  timeout = "5s"
  output {
    traces = [otelcol.exporter.otlphttp.destination.input]
    metrics = [otelcol.exporter.otlphttp.destination.input]
  }
}
otelcol.auth.basic "destination" {
  username = sys.env("GRAFANA_OTLP_USER")
  password = sys.env("GRAFANA_OTLP_TOKEN")
}
otelcol.exporter.otlphttp "destination" {
  client {
    endpoint = sys.env("GRAFANA_OTLP_ENDPOINT")
    auth = otelcol.auth.basic.destination.handler
  }
}
prometheus.remote_write "destination" {
  endpoint {
    url = sys.env("GRAFANA_METRICS_URL")
    basic_auth {
      username = sys.env("GRAFANA_METRICS_USER")
      password = sys.env("GRAFANA_METRICS_TOKEN")
    }
  }
}
loki.write "destination" {
  endpoint {
    url = sys.env("GRAFANA_LOGS_URL")
    basic_auth {
      username = sys.env("GRAFANA_LOGS_USER")
      password = sys.env("GRAFANA_LOGS_TOKEN")
    }
  }
}
pyroscope.receive_http "grot" {
  http {
    listen_address = "0.0.0.0"
    listen_port = 4040
  }
  forward_to = [pyroscope.relabel.identity.receiver]
}
pyroscope.relabel "identity" {
  forward_to = [pyroscope.write.destination.receiver]
  rule {
    target_label = "service_namespace"
    replacement = "grot-emporium"
  }
  rule {
    target_label = "deployment_environment"
    replacement = sys.env("DEPLOYMENT_ENVIRONMENT")
  }
  rule {
    target_label = "deployment_environment_name"
    replacement = sys.env("DEPLOYMENT_ENVIRONMENT")
  }
  rule {
    target_label = "cluster"
    replacement = sys.env("GROT_CLUSTER")
  }
}
pyroscope.write "destination" {
  endpoint {
    url = sys.env("GRAFANA_PROFILES_URL")
    basic_auth {
      username = sys.env("GRAFANA_PROFILES_USER")
      password = sys.env("GRAFANA_PROFILES_TOKEN")
    }
  }
}

// Real Database Observability, not only the PostgreSQL infrastructure integration.
// Only the non-superuser monitoring credential enters Alloy. URL-safe secrets
// are validated by the launcher. Internal demo networking only (no published DB port).
prometheus.exporter.postgres "orders" {
  data_source_names = ["postgresql://db-o11y:" + sys.env("GROT_DB_MONITOR_PASSWORD") + "@postgres:5432/orders?sslmode=disable"]
  enabled_collectors = ["database", "locks", "stat_database", "stat_bgwriter", "stat_user_tables", "statio_user_tables", "stat_statements"]
  stat_statements {
    exclude_users = ["db-o11y", "postgres"]
  }
}
database_observability.postgres "orders" {
  data_source_name = "postgresql://db-o11y:" + sys.env("GROT_DB_MONITOR_PASSWORD") + "@postgres:5432/orders?sslmode=disable"
  targets = prometheus.exporter.postgres.orders.targets
  forward_to = [loki.relabel.database.receiver]
  enable_collectors = ["query_details", "query_samples", "schema_details", "explain_plans"]
  exclude_databases = ["postgres", "template0", "template1"]
  query_samples {
    disable_query_redaction = false
  }
}
loki.relabel "database" {
  forward_to = [loki.write.destination.receiver]
  rule {
    target_label = "job"
    replacement = "integrations/db-o11y"
  }
  rule {
    target_label = "instance"
    replacement = sys.env("GROT_CLUSTER") + "/grot-postgres"
  }
  rule {
    target_label = "cluster"
    replacement = sys.env("GROT_CLUSTER")
  }
  rule {
    target_label = "service_name"
    replacement = "grot-postgres"
  }
  rule {
    target_label = "deployment_environment"
    replacement = sys.env("DEPLOYMENT_ENVIRONMENT")
  }
}
discovery.relabel "database" {
  targets = database_observability.postgres.orders.targets
  rule {
    target_label = "job"
    replacement = "integrations/db-o11y"
  }
  rule {
    target_label = "instance"
    replacement = sys.env("GROT_CLUSTER") + "/grot-postgres"
  }
  rule {
    target_label = "cluster"
    replacement = sys.env("GROT_CLUSTER")
  }
  rule {
    target_label = "service_name"
    replacement = "grot-postgres"
  }
  rule {
    target_label = "deployment_environment"
    replacement = sys.env("DEPLOYMENT_ENVIRONMENT")
  }
}
prometheus.scrape "database" {
  targets = discovery.relabel.database.output
  scrape_interval = "15s"
  forward_to = [prometheus.remote_write.destination.receiver]
}
// Only PostgreSQL lines go to the DB error collector. Original server logs
// also flow through the existing application log pipeline.
loki.process "database_logs" {
  stage.match {
    selector = "{service_name!=\"grot-postgres\"}"
    action = "drop"
  }
  forward_to = [database_observability.postgres.orders.logs_receiver]
}

prometheus.scrape "grot" {
  scrape_interval = "15s"
  targets = [
    {"__address__" = "ui:8080", "__metrics_path__" = "/actuator/prometheus", "service_name" = "grot-ui"},
    {"__address__" = "cart:8080", "__metrics_path__" = "/actuator/prometheus", "service_name" = "grot-cart"},
    {"__address__" = "orders:8080", "__metrics_path__" = "/actuator/prometheus", "service_name" = "grot-orders"},
    {"__address__" = "catalog:8080", "__metrics_path__" = "/metrics", "service_name" = "grot-catalog"},
    {"__address__" = "checkout:8080", "__metrics_path__" = "/metrics", "service_name" = "grot-checkout"},
  ]
  forward_to = [prometheus.relabel.identity.receiver]
}
prometheus.relabel "identity" {
  forward_to = [prometheus.remote_write.destination.receiver]
  // The managed Compose deployment runs one instance per service. Match the
  // per-launch identity injected by runtime-entrypoint.sh, not the DNS address.
  rule {
    source_labels = ["service_name"]
    target_label = "instance"
    replacement = sys.env("GROT_INSTANCE_PREFIX") + "-$1"
  }
  rule {
    target_label = "grafana_host_id"
    replacement = sys.env("GROT_HOST_ID")
  }
  rule {
    target_label = "service_namespace"
    replacement = "grot-emporium"
  }
  rule {
    target_label = "deployment_environment"
    replacement = sys.env("DEPLOYMENT_ENVIRONMENT")
  }
  rule {
    target_label = "cluster"
    replacement = sys.env("GROT_CLUSTER")
  }
  rule {
    source_labels = ["service_name"]
    target_label = "job"
    replacement = "grot-emporium/$1"
  }
}
// Docker sends only these services' logs over loopback syslog. No Docker socket.
loki.relabel "syslog" {
  forward_to = []
  rule {
    source_labels = ["__syslog_message_app_name"]
    regex = "grot-(ui|cart|orders|catalog|checkout|postgres)"
    action = "keep"
  }
  rule {
    source_labels = ["__syslog_message_app_name"]
    target_label = "service_name"
  }
}
loki.source.syslog "grot" {
  listener {
    address = "0.0.0.0:1514"
    protocol = "tcp"
    max_message_length = 65536
    labels = {
      "service_namespace" = "grot-emporium",
      "deployment_environment" = sys.env("DEPLOYMENT_ENVIRONMENT"),
      "cluster" = sys.env("GROT_CLUSTER"),
    }
  }
  relabel_rules = loki.relabel.syslog.rules
  forward_to = [loki.write.destination.receiver, loki.process.database_logs.receiver]
}

// cAdvisor runs separately with host mounts; only this Compose project's
// container series are forwarded. No extra ingestion credentials.
prometheus.scrape "docker_containers" {
  targets = [{
    "__address__" = "cadvisor:8080",
    "job" = "integrations/cadvisor",
    "instance" = sys.env("GROT_CLUSTER") + "/docker",
    "cluster" = sys.env("GROT_CLUSTER"),
  }]
  scrape_interval = "15s"
  forward_to = [prometheus.relabel.docker_containers.receiver]
}
prometheus.relabel "docker_containers" {
  forward_to = [prometheus.remote_write.destination.receiver]
  rule {
    source_labels = ["__name__", "container_label_com_docker_compose_project"]
    regex = "(up|scrape_.*);.*|container_.*;" + sys.env("GROT_DOCKER_PROJECT")
    action = "keep"
  }
  rule {
    source_labels = ["container_label_com_docker_compose_service"]
    regex = "(.+)"
    target_label = "service_name"
    replacement = "grot-$1"
  }
}
// CPU/memory/disk/filesystem metrics from the Linux Docker host. On Docker
// Desktop this is the Docker Linux VM, not macOS/Windows.
prometheus.scrape "docker_host" {
  targets = [{
    "__address__" = "node-exporter:9100",
    "job" = "integrations/node_exporter",
    "instance" = sys.env("GROT_CLUSTER") + "/host",
    "cluster" = sys.env("GROT_CLUSTER"),
  }]
  scrape_interval = "15s"
  forward_to = [prometheus.remote_write.destination.receiver]
}
