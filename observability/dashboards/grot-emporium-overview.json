{
  "uid": "grot-emporium-overview",
  "title": "Grot Emporium \u2022 Overview",
  "description": "Source-informed business, HTTP RED, database, infrastructure and optional AI overview. Queries validated against emitted telemetry; no simulated monitoring data.",
  "tags": [
    "grot-emporium",
    "demo",
    "observability"
  ],
  "schemaVersion": 39,
  "version": 0,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "1m",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "metrics",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "grafanacloud-prom",
          "value": "grafanacloud-prom"
        },
        "options": [],
        "refresh": 1
      },
      {
        "name": "logs",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "current": {
          "text": "grafanacloud-logs",
          "value": "grafanacloud-logs"
        },
        "options": [],
        "refresh": 1
      },
      {
        "name": "traces",
        "label": "Traces",
        "type": "datasource",
        "query": "tempo",
        "current": {
          "text": "grafanacloud-traces",
          "value": "grafanacloud-traces"
        },
        "options": [],
        "refresh": 1
      },
      {
        "name": "profiles",
        "label": "Profiles",
        "type": "datasource",
        "query": "grafana-pyroscope-datasource",
        "current": {
          "text": "grafanacloud-profiles",
          "value": "grafanacloud-profiles"
        },
        "options": [],
        "refresh": 1
      },
      {
        "name": "cluster",
        "label": "Deployment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${metrics}"
        },
        "query": "label_values(grot_orders_total, cluster)",
        "definition": "label_values(grot_orders_total, cluster)",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "allValue": null,
        "current": {},
        "options": []
      },
      {
        "name": "namespace",
        "label": "Kubernetes namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${metrics}"
        },
        "query": "label_values(up{cluster=~\"$cluster\",service_namespace=\"grot-emporium\"}, namespace)",
        "definition": "label_values(up{cluster=~\"$cluster\",service_namespace=\"grot-emporium\"}, namespace)",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "allValue": null,
        "current": {},
        "options": []
      },
      {
        "name": "service",
        "label": "App services",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${metrics}"
        },
        "query": "label_values(up{cluster=~\"$cluster\",job=~\"grot-emporium/.*\",service_name=~\"grot-(ui|cart|orders|catalog|checkout)\"}, service_name)",
        "definition": "label_values(up{cluster=~\"$cluster\",job=~\"grot-emporium/.*\",service_name=~\"grot-(ui|cart|orders|catalog|checkout)\"}, service_name)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview \u2022 shopping activity and service impact",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "title": "Healthy service scrapes",
      "type": "stat",
      "description": "Number of selected app services with at least one successful scrape. This is scrape health, not an end-user availability SLO.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (service_name) (up{service_namespace=\"grot-emporium\",cluster=~\"$cluster\",service_name=~\"$service\",job=~\"grot-emporium/.*\"}))",
          "legendFormat": "{{service_name}}",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No telemetry",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "title": "Orders \u2022 selected range",
      "type": "stat",
      "description": "Synthetic orders accepted by OrderService. Micrometer grot.orders.created is exposed as grot_orders_total. Prometheus increase is extrapolated; not a database row count.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(grot_orders_total{cluster=~\"$cluster\"}[$__range]))",
          "legendFormat": "{{service_name}}",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No telemetry",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 4,
      "title": "Items \u2022 selected range",
      "type": "stat",
      "description": "Synthetic item quantities in accepted orders. Business panels always cover the whole selected deployment.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(grot_orders_items_total{cluster=~\"$cluster\"}[$__range]))",
          "legendFormat": "{{service_name}}",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No telemetry",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 5,
      "title": "Simulated order value",
      "type": "stat",
      "description": "Demo catalog price \u00d7 item quantity, accumulated for accepted orders. Not real revenue or model spend.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(grot_orders_value_total{cluster=~\"$cluster\"}[$__range]))",
          "legendFormat": "{{service_name}}",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No telemetry",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 6,
      "title": "HTTP requests / second",
      "type": "timeseries",
      "description": "Combines Spring/Micrometer and Go/Node histogram counts. Excludes actuator, health and metrics endpoints; includes static assets and synthetic fault traffic. Requests across services are not unique user journeys.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate({__name__=~\"http_server_requests_seconds_count|http_server_request_duration_seconds_count\",service_namespace=\"grot-emporium\",cluster=~\"$cluster\",service_name=~\"$service\",uri!~\"/actuator.*\",route!~\"/(health.*|metrics.*)\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}}",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No telemetry",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "HTTP 5xx \u2022 % of requests",
      "type": "timeseries",
      "description": "Zero is shown only when the service has a request counter but no 5xx series. No-traffic periods may be undefined. Includes intentionally injected failures.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum by (service_name) (rate({__name__=~\"http_server_requests_seconds_count|http_server_request_duration_seconds_count\",service_namespace=\"grot-emporium\",cluster=~\"$cluster\",service_name=~\"$service\",uri!~\"/actuator.*\",route!~\"/(health.*|metrics.*)\",status=~\"5..\"}[$__rate_interval])) or on(service_name) (0 * sum by (service_name) (rate({__name__=~\"http_server_requests_seconds_count|http_server_request_duration_seconds_count\",service_namespace=\"grot-emporium\",cluster=~\"$cluster\",service_name=~\"$service\",uri!~\"/actuator.*\",route!~\"/(health.*|metrics.*)\"}[$__rate_interval])))) / sum by (service_name) (rate({__name__=~\"http_server_requests_seconds_count|http_server_request_duration_seconds_count\",service_namespace=\"grot-emporium\",cluster=~\"$cluster\",service_name=~\"$service\",uri!~\"/actuator.*\",route!~\"/(health.*|metrics.*)\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}}",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "No telemetry",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "title": "HTTP latency \u2022 p95",
      "type": "timeseries",
      "description": "Classic histogram estimate by service. Includes request-scoped synthetic latency faults; percentiles are never averaged.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,service_name) (rate({__name__=~\"http_server_requests_seconds_bucket|http_server_request_duration_seconds_bucket\",service_namespace=\"grot-emporium\",cluster=~\"$cluster\",service_name=~\"$service\",uri!~\"/actuator.*\",route!~\"/(health.*|metrics.*)\"}[$__rate_interval])))",
          "legendFormat": "{{service_name}}",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No telemetry",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "title": "Accepted orders / minute",
      "type": "timeseries",
      "description": "Business throughput, independent of HTTP hop counts. A successful journey should generate an accepted order.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum(rate(grot_orders_total{cluster=~\"$cluster\"}[$__rate_interval]))",
          "legendFormat": "orders/min",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No telemetry",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "PostgreSQL \u2022 connectivity, transactions and pressure",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 11,
      "title": "PostgreSQL exporter reachability",
      "type": "timeseries",
      "description": "1 = exporter can reach PostgreSQL; 0 = unavailable. This does not prove query latency or customer-data durability.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(pg_up{cluster=~\"$cluster\",service_name=\"grot-postgres\"})",
          "legendFormat": "PostgreSQL",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No telemetry",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "title": "Transactions / second",
      "type": "timeseries",
      "description": "Committed transactions, including background work. Not equivalent to shopping orders.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "x": 8,
        "y": 20,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (datname) (rate(pg_stat_database_xact_commit{cluster=~\"$cluster\",datname!~\"template.*\"}[$__rate_interval]))",
          "legendFormat": "{{datname}}",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No telemetry",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "title": "Database connections",
      "type": "timeseries",
      "description": "Current database connections by database.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "x": 16,
        "y": 20,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (datname) (pg_stat_database_numbackends{cluster=~\"$cluster\",datname!~\"template.*\"})",
          "legendFormat": "{{datname}}",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No telemetry",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 14,
      "title": "Rollbacks / second",
      "type": "timeseries",
      "description": "Transaction rollbacks, not necessarily application errors.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (datname) (rate(pg_stat_database_xact_rollback{cluster=~\"$cluster\",datname!~\"template.*\"}[$__rate_interval]))",
          "legendFormat": "{{datname}}",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No telemetry",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 15,
      "title": "Orders connection pool \u2022 active",
      "type": "timeseries",
      "description": "Active JDBC connections in the orders service. Correlate with request latency and database connections.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(hikaricp_connections_active{cluster=~\"$cluster\",service_name=\"grot-orders\"})",
          "legendFormat": "active connections",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No telemetry",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
